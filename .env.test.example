# ==========================================
# TEST ENVIRONMENT CONFIGURATION (.env.test)
# ==========================================
# Ushbu fayldan nusxa olib `.env.test` yarating:
# cp .env.test.example .env.test
#
# `scripts/test-runner.ts` agar `.env.test` mavjud bo'lsa,
# avtomatik ravishda uni yuklaydi va testlarni asosiy (dev/production)
# bazadan to'liq ajratilgan holda xavfsiz ishga tushiradi.

# ==========================================
# TEST DATABASE SETTINGS (Alohida test bazasi)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mebel_test_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mebel_test_db?schema=public"

# ==========================================
# TEST SECURITY & AUTH
# ==========================================
JWT_SECRET="test-jwt-secret-min-32-characters-long-example-12345"

# ==========================================
# TEST TELEGRAM SETTINGS
# ==========================================
TELEGRAM_BOT_TOKEN="123456789:TEST_BOT_TOKEN_DO_NOT_USE_IN_PROD"
TELEGRAM_WEBHOOK_SECRET="test-webhook-secret-token"
TELEGRAM_FACTORY_CHANNEL_ID="-1001999999999"
TELEGRAM_SUPPORT_GROUP_ID="-1001888888888"
ADMIN_TELEGRAM_IDS="12345678"

# ==========================================
# TEST APP URL
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
